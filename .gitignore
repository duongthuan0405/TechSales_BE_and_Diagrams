## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is a combination of the Visual Studio .gitignore from
## https://github.com/github/gitignore/blob/master/VisualStudio.gitignore
## and the JetBrains .gitignore from
## https://github.com/github/gitignore/blob/master/Global/JetBrains.gitignore

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto-generated files
mono_crash.*

# Windows image build caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Others
*.Cache
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.user
*.sqlproj.user
*.jfm

# OS X temporary files
.DS_Store
.AppleDouble
.LSOverride

# CoreCLR dumps
core.*

# User-specific files (JetBrains Rider)
.idea/
*.sln.iml

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Core
wwwroot/lib/

# User secrets
secrets.json

# Environment files
.env
.env.*

!.env.example.*
!.env.example

# SQL Server files
*.mdf
*.ldf
*.ndf

# Backup & report files from Conversion Wizard
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/

# Others
/TestResults/
/Build/
